NODE_ENV=development
PORT=3001

# Runtime persistence. Use an absolute path on production servers, e.g. /var/lib/funnelpilot/data.
DATA_DIR=./data

# Dashboard/API deployment
PUBLIC_BACKEND_URL=https://example.com
WEBHOOK_BASE_URL=https://example.com
CORS_ORIGIN=https://example.com
DISABLE_DESTRUCTIVE_ROUTES=true
ENABLE_GENERIC_WEBHOOKS=false

# Production-only defense in depth:
# Backend now listens ONLY on 127.0.0.1, even in production.
# A trusted HTTPS reverse proxy MUST authenticate every admin session,
# STRIP any browser-supplied X-Funnelpilot-Admin-Ingress header and REPLACE it
# server-side with this secret (>=32 UTF-8 bytes) for admin API requests.
# Never put the value into the browser, Vite variables, GitHub or public NGINX files.
# Until configured, production admin endpoints FAIL CLOSED with HTTP 503.
# A shared secret alone is NOT a login system, RBAC or tenant isolation.
FUNNELPILOT_ADMIN_INGRESS_SECRET=

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=replace-with-meta-verify-token
META_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-access-token
META_ACCESS_TOKEN=replace-with-whatsapp-access-token
META_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
META_WABA_ID=replace-with-meta-waba-id
META_GRAPH_API_VERSION=v20.0
WHATSAPP_SEND_ENABLED=false
# Safety-first: even if sending is activated later, only explicitly allowed
# recipient E.164 numbers may receive WhatsApp messages (all send paths).
# For one approved test number use an individual ID; never commit real numbers.
WHATSAPP_ALLOWED_RECIPIENT_IDS=
# Enable only after separate business/legal/ManyChat cutover, NOT in pilot tests.
WHATSAPP_ALLOW_ALL_RECIPIENTS=false

# Meta Instagram Messaging API (Instagram Login)
# Safe default: webhook can be connected while the Conversation Engine and outbound remain off.
# For the first live test, enable the engine and allow only the second/test account IGSID.
INSTAGRAM_ENGINE_ENABLED=false
# Safe coexistence default: keep this false while ManyChat is active.
# For tests, set INSTAGRAM_ALLOWED_SENDER_IDS to the second-account IGSID.
# Only set ALLOW_ALL_SENDERS=true after deliberate cutover away from coexistence.
INSTAGRAM_ALLOWED_SENDER_IDS=
INSTAGRAM_ALLOW_ALL_SENDERS=false
# While ManyChat runs in parallel, keep new Instagram leads disabled in Funnel Pilot.
# Later, after deliberate cutover away from ManyChat, this can be set to true.
INSTAGRAM_AUTO_ENABLE_NEW_LEADS=false
INSTAGRAM_VERIFY_TOKEN=replace-with-instagram-verify-token
# Instagram API with Instagram Login can have its own App Secret.
# Use that dedicated secret here; META_APP_SECRET remains for the Meta/WhatsApp app context.
INSTAGRAM_APP_SECRET=replace-with-instagram-app-secret
INSTAGRAM_ACCESS_TOKEN=replace-with-instagram-access-token
INSTAGRAM_ACCOUNT_ID=replace-with-instagram-professional-account-id
INSTAGRAM_GRAPH_API_VERSION=v26.0
INSTAGRAM_SEND_ENABLED=false

# OpenAI
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# Calendly
CALENDLY_PAT=replace-with-calendly-personal-access-token
CALENDLY_WEBHOOK_SECRET=replace-with-calendly-webhook-secret
CALENDLY_WEBHOOK_VERIFY_MODE=strict

# Optional OAuth connections (single local workspace, no SaaS tenancy yet)
# Create a private 32-byte random encryption key as hex. Never commit it.
OAUTH_TOKEN_ENCRYPTION_KEY=
# OAuth callbacks must exactly match the developer apps' registered redirect URIs.
# Local callback uses localhost:3001 (NOT 127.0.0.1) by default.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/integrations/oauth/google_calendar/callback
CALENDLY_OAUTH_CLIENT_ID=
CALENDLY_OAUTH_CLIENT_SECRET=
CALENDLY_OAUTH_REDIRECT_URI=http://localhost:3001/integrations/oauth/calendly/callback
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
HUBSPOT_OAUTH_REDIRECT_URI=http://localhost:3001/integrations/oauth/hubspot/callback
# Production HTTPS dashboard origin; OAuth callbacks require own public HTTPS routing.
PUBLIC_DASHBOARD_URL=
