# Temporary synthetic Pete lab only. No Admin Dashboard in public bundle.
FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY backend/package*.json ./backend/
RUN npm ci --prefix backend
COPY backend/ ./backend/
RUN cd backend && npx tsx --test src/config/pete-a-minus-remediation.test.ts src/config/pete-mobile-lab.test.ts src/config/pete-api-budget-phase47.test.ts src/config/pete-phase54-context-regressions.test.ts src/config/pete-setter-stress-phase58.test.ts src/config/pete-setter-stress-matrix.test.ts src/config/pete-four-colors-phase59.test.ts src/config/pete-llm-phase46.test.ts src/config/natural-pete-conversation-review.test.ts
RUN npm run build --prefix backend
COPY dashboard/package*.json ./dashboard/
RUN npm ci --prefix dashboard
COPY dashboard/ ./dashboard/
RUN cd dashboard && node --test src/mobile/peteLabBudget.test.js src/mobile/peteLabReview.test.js src/mobile/peteLabSpeech.test.js
COPY mobile-lab/launcher.mjs mobile-lab/yoda-smoke.mjs mobile-lab/yoda-exam.mjs mobile-lab/yoda-exam.test.mjs ./mobile-lab/
RUN node --check mobile-lab/launcher.mjs && node --check mobile-lab/yoda-smoke.mjs && node --check mobile-lab/yoda-exam.mjs
RUN node --test mobile-lab/yoda-exam.test.mjs
RUN npm run build:lab --prefix dashboard

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/backend/dist ./backend/dist
COPY --from=builder /app/backend/node_modules ./backend/node_modules
COPY --from=builder /app/mobile-lab-dist ./mobile-lab-dist
COPY mobile-lab/gateway.mjs mobile-lab/launcher.mjs mobile-lab/yoda-smoke.mjs mobile-lab/yoda-exam.mjs ./mobile-lab/
# The only public process is the authenticated gateway.
# Pete itself binds 127.0.0.1:3011 only.
EXPOSE 8080
CMD ["node", "mobile-lab/launcher.mjs"]
